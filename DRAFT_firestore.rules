rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    
    // We check if the user is in the admins collection
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }

    match /system/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /records/{recordId} {
      allow read: if true;
      allow create: if isAdmin() && 
        request.resource.data.keys().hasAll(['id', 'name', 'month', 'amount', 'type']) &&
        request.resource.data.keys().size() >= 5;
      allow update, delete: if isAdmin();
    }
    
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false; // Only manageable through Firebase Console initially, or we bootstrap one.
    }
  }
}
